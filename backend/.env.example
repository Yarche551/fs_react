# Строка подключения к MongoDB (локально можно не задавать — используется mongodb://127.0.0.1:27017)
DB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=freelancers

# Секрет для подписи JWT — на проде обязательно свой, длинный и случайный
SECRET=

# Порт (на Render подставляется автоматически)
PORT=3000

# Домен фронтенда для CORS, можно несколько через запятую.
# Если не задан — CORS открыт для всех (режим разработки).
CORS_ORIGIN=https://fs-react-web.onrender.com
